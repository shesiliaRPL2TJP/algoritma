/* === SELECTOR KOMBINASI === */

/* Descendant: semua <a> di dalam nav */
nav a { color: white; text-decoration: none; }

/* Child: hanya <li> langsung dari .menu */
.menu > li { display: inline-block; }

/* nth-child: baris genap tabel warna berbeda (zebra striping) */
tr:nth-child(even) { background-color: #F2F3F4; }
tr:nth-child(odd)  { background-color: white; }

/* Setiap 3 elemen, mulai dari elemen ke-1 (1, 4, 7, 10...) */
li:nth-child(3n+1) { font-weight: bold; }

/* === PSEUDO-CLASS === */
.tombol:hover { background: #1A5276; transform: translateY(-2px); }
.tombol:active { transform: translateY(0); }

input:focus {
    outline: none;
    border-color: #2E86C1;
    box-shadow: 0 0 0 3px rgba(46, 134, 193, 0.3);
}

/* === PSEUDO-ELEMENT === */
/* Menambahkan ikon sebelum judul section */
h2::before {
    content: '▶️ ';
    color: #2E86C1;
}

/* Garis dekoratif setelah judul */
h2::after {
    content: '';
    display: block;
    width: 60px;
    height: 3px;
    background: #D4AC0D;
    margin-top: 8px;
}

/* Huruf pertama diperbesar (drop cap) */
p.artikel::first-letter {
    font-size: 3em;
    font-weight: bold;
    float: left;
    line-height: 1;
    margin-right: 8px;
    color: #1A5276;
}

/* Warna teks yang diseleksi */
::selection {
    background: #AED6F1;
    color: #1A5276;
}