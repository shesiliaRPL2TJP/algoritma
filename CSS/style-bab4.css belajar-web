/* ===== RESET & BASE ===== */
* {
    margin: 0;
    padding: 0;
    box-sizing: border-box; /* Agar padding tidak menambah lebar elemen */
}

body {
    font-family: Arial, Helvetica, sans-serif;
    font-size: 16px;
    line-height: 1.7;
    color: #2C3E50;
    background-color: #F2F3F4;
}

/* ===== SELECTOR ELEMEN ===== */
h1 {
    font-size: 2.5rem;
    letter-spacing: 2px;
    text-transform: uppercase;
}

h2 {
    font-size: 1.4rem;
    color: #1A5276;
    margin-bottom: 10px;
    border-bottom: 2px solid #AED6F1;
    padding-bottom: 6px;
}

p {
    margin-bottom: 8px;
    text-align: justify;
}

code {
    background-color: #EBF5FB;
    color: #1A5276;
    padding: 2px 6px;
    border-radius: 4px;
    font-family: 'Courier New', monospace;
    font-size: 0.9rem;
}

/* ===== SELECTOR ID - Header ===== */
#site-header {
    background: linear-gradient(135deg, #1A5276, #2E86C1);
    color: white;
    text-align: center;
    padding: 40px 20px;
}

#site-header p {
    color: #AED6F1;
    font-style: italic;
    margin-top: 8px;
    font-size: 1.1rem;
}

/* ===== SELECTOR ID - Footer ===== */
#site-footer {
    background-color: #2C3E50;
    color: #BDC3C7;
    text-align: center;
    padding: 20px;
    margin-top: 40px;
    font-size: 0.9rem;
}

/* ===== SELECTOR CLASS - Layout ===== */
.konten-utama {
    max-width: 900px;
    margin: 30px auto; /* Rata tengah secara horizontal */
    padding: 0 20px;
}

.kartu {
    background-color: white;
    border: 1px solid #BDC3C7;
    border-radius: 8px;
    padding: 24px;
    margin-bottom: 20px;
    box-shadow: 0 2px 6px rgba(0, 0, 0, 0.08);
}

/* Class ganda: .kartu.highlight = elemen yang punya KEDUA class */
.kartu.highlight {
    border-left: 5px solid #D4AC0D;
    background-color: #FEF9E7;
}

/* ===== PROPERTI TEKS ===== */
.teks-kecil {
    font-size: 0.85rem;
    color: #7F8C8D;
    font-style: italic;
}

.teks-besar {
    font-size: 1.4rem;
    font-weight: bold;
    letter-spacing: 4px;
    color: #1A5276;
}

.teks-bayangan {
    font-size: 1.2rem;
    font-weight: bold;
    color: #2E86C1;
    text-shadow: 2px 2px 0px rgba(26, 82, 118, 0.3);
}

.teks-kapital {
    text-transform: uppercase;
    font-weight: bold;
    letter-spacing: 3px;
    font-size: 0.9rem;
    color: #CA6F1E;
}

/* ===== BACKGROUND ===== */
#demo-warna {
    background-color: #EBF5FB;
    border-color: #2E86C1;
}

.demo-bg {
    background: linear-gradient(120deg, #1A5276, #2E86C1, #AED6F1);
    color: white;
    border: none;
}

.demo-bg h2 {
    color: white;
    border-bottom-color: rgba(255, 255, 255, 0.4);
}

.demo-bg p {
    color: rgba(255, 255, 255, 0.9);
}

/* Grouping selector */
h1, h2 {
    font-family: Georgia, 'Times New Roman', serif;
}

/* Descendant selector: <p> di dalam .kartu.highlight */
.kartu.highlight p {
    color: #7D6608;
}

/* Pseudo-class: saat elemen .kartu di-hover */
.kartu:hover {
    box-shadow: 0 6px 20px rgba(0, 0, 0, 0.15);
    transform: translateY(-2px);
    transition: all 0.3s ease;
}

